# my.telegram.org -> API development tools
API_ID=
API_HASH=
# токен от BotFather (бот должен быть админом в вашем канале)
BOT_TOKEN=
# ID каналов (узнать: python -m signalbot.login), вида -100xxxxxxxxxx
SOURCE_CHANNEL=
TARGET_CHANNEL=
# кому слать недельную/месячную статистику
ADMIN_ID=7842338078
TZ_NAME=Europe/Moscow
STATS_TIME=23:40
CANCEL_DELAY_MIN=10

# --- Источник 2 (Forex Bulls). Каналы источников и приёмников выбираются в панели бота: /panel
# ключ Claude API для перевода реплаев (console.anthropic.com)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# цена FxPro: cTrader Open API (openapi.ctrader.com -> приложение; счёт FxPro cTrader, можно демо).
# Впишите CLIENT_ID и CLIENT_SECRET, остальное заполнит  python -m signalbot.ctrader_setup
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=
CTRADER_ACCOUNT_ID=
# 1 — реальный счёт, 0 — демо
CTRADER_LIVE=1
FXPRO_SYMBOL=XAUUSD
# временно вместо FxPro: цена OANDA (oanda.com -> Manage API Access -> токен). 0 — демо-счёт, 1 — реальный
OANDA_TOKEN=
OANDA_LIVE=0
